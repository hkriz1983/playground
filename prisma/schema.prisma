generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Note {
  id           String      @id @default(uuid())
  userId       String      @map("user_id") // Links to Playground User Master
  title        String
  content      String?
  category     String?     @default("General") // e.g., Work, Personal, Quick
  taskHeaderId String?     @map("task_header_id")
  reminderAt   DateTime?   @map("reminder_at") // NULL if pure note
  isCompleted  Boolean?    @default(false) @map("is_completed") // For reminder status
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  taskHeader   TaskHeader? @relation(fields: [taskHeaderId], references: [id], onDelete: SetNull)

  @@index([userId, reminderAt, isCompleted])
  @@index([taskHeaderId])
  @@map("notes")
}

model TaskHeader {
  id        String   @id @default(uuid())
  userId    String   @default("mock-user-1234") @map("user_id")
  name      String
  color     String?  @default("primary")
  icon      String?  @default("folder")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  notes     Note[]

  @@map("task_headers")
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  role        String   @default("USER")
  designation String?
  avatar      String?
  avatarColor String   @default("primary")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  appAccess   UserAppAccess[]

  @@map("users")
}

model App {
  id          String   @id @default(uuid())
  name        String
  description String
  icon        String
  color       String   @default("primary")
  appLink     String?
  github      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  userAccess  UserAppAccess[]

  @@map("apps")
}

model UserAppAccess {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  appId     String   @map("app_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([userId, appId])
  @@map("user_app_access")
}

model LedgerCategory {
  id          String   @id @default(uuid())
  userId      String   @default("mock-user-1234") @map("user_id")
  name        String
  unitWord    String   @default("session")
  isFixedRate Boolean  @default(true)
  defaultRate Float    @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  entries     LedgerEntry[]

  @@map("ledger_categories")
}

model LedgerEntry {
  id          String   @id @default(uuid())
  userId      String   @default("mock-user-1234") @map("user_id")
  date        DateTime
  amount      Float
  description String?
  categoryId  String   @map("category_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category    LedgerCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([categoryId])
  @@map("ledger_entries")
}

model LedgerPayment {
  id          String   @id @default(uuid())
  userId      String   @default("mock-user-1234") @map("user_id")
  date        DateTime
  amount      Float
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@map("ledger_payments")
}

model LedgerPlayer {
  id          String   @id @default(uuid())
  userId      String   @default("mock-user-1234") @map("user_id")
  name        String
  role        String   @default("Player")
  phone       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  payments    PlayerPayment[]

  @@map("ledger_players")
}

model PlayerPayment {
  id          String   @id @default(uuid())
  userId      String   @default("mock-user-1234") @map("user_id")
  playerId    String   @map("player_id")
  amount      Float
  date        DateTime
  againstWhat String
  receiptUrl  String?  @map("receipt_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  player      LedgerPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([playerId])
  @@map("player_payments")
}

model SplittzyFriend {
  id           String                  @id @default(uuid())
  userId       String                  @default("mock-user-1234") @map("user_id")
  name         String
  nickname     String
  phone        String?
  upiId        String?                 @map("upi_id")
  avatar       String?
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  participants SplittzyBillParticipant[]

  @@map("splittzy_friends")
}

model SplittzyBill {
  id           String                  @id @default(uuid())
  userId       String                  @default("mock-user-1234") @map("user_id")
  title        String
  date         DateTime                @default(now())
  totalAmount  Float                   @map("total_amount")
  splitMode    String                  @default("AUTO") @map("split_mode") // AUTO | CUSTOM_PERCENTAGE | CUSTOM_EXACT
  billPhotos   String?                 @map("bill_photos") // JSON array of string URLs
  shareCode    String                  @unique @default(uuid()) @map("share_code")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  participants SplittzyBillParticipant[]

  @@map("splittzy_bills")
}

model SplittzyBillParticipant {
  id                String         @id @default(uuid())
  billId            String         @map("bill_id")
  friendId          String         @map("friend_id")
  shareAmount       Float          @map("share_amount")
  percentage        Float?         @default(0)
  exactAmount       Float?         @map("exact_amount")
  status            String         @default("PENDING") @map("status") // PENDING | PAYMENT_UPLOADED | PAID
  paymentScreenshot String?        @map("payment_screenshot")
  paidAt            DateTime?      @map("paid_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  bill              SplittzyBill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  friend            SplittzyFriend @relation(fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([billId, friendId])
  @@index([billId])
  @@index([friendId])
  @@map("splittzy_bill_participants")
}

