generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Note {
  id           String    @id @default(uuid())
  userId       String    @map("user_id") // Links to Playground User Master
  title        String
  content      String?
  category     String?   @default("General") // e.g., Work, Personal, Quick
  reminderAt   DateTime? @map("reminder_at") // NULL if pure note
  isCompleted  Boolean?  @default(false) @map("is_completed") // For reminder status
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([userId, reminderAt, isCompleted])
  @@map("notes")
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  role        String   @default("USER")
  designation String?
  avatar      String?
  avatarColor String   @default("primary")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  appAccess   UserAppAccess[]

  @@map("users")
}

model App {
  id          String   @id @default(uuid())
  name        String
  description String
  icon        String
  color       String   @default("primary")
  appLink     String?
  github      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  userAccess  UserAppAccess[]

  @@map("apps")
}

model UserAppAccess {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  appId     String   @map("app_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([userId, appId])
  @@map("user_app_access")
}

model LedgerCategory {
  id          String   @id @default(uuid())
  name        String
  unitWord    String   @default("session")
  isFixedRate Boolean  @default(true)
  defaultRate Float    @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  entries     LedgerEntry[]

  @@map("ledger_categories")
}

model LedgerEntry {
  id          String   @id @default(uuid())
  date        DateTime
  amount      Float
  description String?
  categoryId  String   @map("category_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category    LedgerCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([categoryId])
  @@map("ledger_entries")
}

model LedgerPayment {
  id          String   @id @default(uuid())
  date        DateTime
  amount      Float
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@map("ledger_payments")
}

model LedgerPlayer {
  id          String   @id @default(uuid())
  name        String
  role        String   @default("Player")
  phone       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  payments    PlayerPayment[]

  @@map("ledger_players")
}

model PlayerPayment {
  id          String   @id @default(uuid())
  playerId    String   @map("player_id")
  amount      Float
  date        DateTime
  againstWhat String
  receiptUrl  String?  @map("receipt_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  player      LedgerPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([playerId])
  @@map("player_payments")
}
